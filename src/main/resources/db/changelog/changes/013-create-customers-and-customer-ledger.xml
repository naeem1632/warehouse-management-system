<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="013-create-customers-table" author="system">
        <comment>Create customers table for customer management</comment>
        <createTable tableName="customers">
            <column name="id" type="BIGSERIAL">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="code" type="VARCHAR(20)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="name" type="VARCHAR(200)">
                <constraints nullable="false"/>
            </column>
            <column name="business_type" type="VARCHAR(50)"/>
            <column name="contact_person" type="VARCHAR(100)"/>
            <column name="designation" type="VARCHAR(50)"/>
            <column name="phone" type="VARCHAR(20)"/>
            <column name="alternate_phone" type="VARCHAR(20)"/>
            <column name="email" type="VARCHAR(100)"/>
            <column name="address" type="TEXT"/>
            <column name="city" type="VARCHAR(50)"/>
            <column name="ntn" type="VARCHAR(50)"/>
            <column name="strn" type="VARCHAR(50)"/>
            <column name="payment_terms" type="VARCHAR(100)"/>
            <column name="credit_limit" type="DECIMAL(15,2)"/>
            <column name="opening_balance" type="DECIMAL(15,2)" defaultValue="0"/>
            <column name="opening_balance_type" type="VARCHAR(10)"/>
            <column name="opening_date" type="DATE"/>
            <column name="status" type="VARCHAR(20)" defaultValue="ACTIVE"/>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP"/>
            <column name="updated_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP"/>
        </createTable>

        <createIndex indexName="idx_customers_code" tableName="customers">
            <column name="code"/>
        </createIndex>
        <createIndex indexName="idx_customers_name" tableName="customers">
            <column name="name"/>
        </createIndex>
        <createIndex indexName="idx_customers_status" tableName="customers">
            <column name="status"/>
        </createIndex>
    </changeSet>

    <changeSet id="013-create-customer-ledger-table" author="system">
        <comment>Create customer_ledger table for tracking customer transactions</comment>
        <createTable tableName="customer_ledger">
            <column name="id" type="BIGSERIAL">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="customer_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_customer_ledger_customer"
                             references="customers(id)"/>
            </column>
            <column name="transaction_date" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="VARCHAR(500)"/>
            <column name="reference_type" type="VARCHAR(50)"/>
            <column name="reference_id" type="BIGINT"/>
            <column name="debit" type="DECIMAL(15,2)" defaultValue="0"/>
            <column name="credit" type="DECIMAL(15,2)" defaultValue="0"/>
            <column name="balance" type="DECIMAL(15,2)"/>
            <column name="balance_type" type="VARCHAR(10)"/>
            <column name="created_by" type="BIGINT">
                <constraints foreignKeyName="fk_customer_ledger_user"
                             references="users(id)"/>
            </column>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP"/>
        </createTable>

        <createIndex indexName="idx_customer_ledger_customer" tableName="customer_ledger">
            <column name="customer_id"/>
        </createIndex>
        <createIndex indexName="idx_customer_ledger_date" tableName="customer_ledger">
            <column name="transaction_date"/>
        </createIndex>
        <createIndex indexName="idx_customer_ledger_reference" tableName="customer_ledger">
            <column name="reference_type"/>
            <column name="reference_id"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
