<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="003-1-create-suppliers-table" author="system">
        <createTable tableName="suppliers">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="code" type="VARCHAR(20)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="name" type="VARCHAR(200)">
                <constraints nullable="false"/>
            </column>
            <column name="business_type" type="VARCHAR(50)"/>
            <column name="contact_person" type="VARCHAR(100)"/>
            <column name="designation" type="VARCHAR(50)"/>
            <column name="phone" type="VARCHAR(20)"/>
            <column name="alternate_phone" type="VARCHAR(20)"/>
            <column name="email" type="VARCHAR(100)"/>
            <column name="address" type="TEXT"/>
            <column name="city" type="VARCHAR(50)"/>
            <column name="ntn" type="VARCHAR(50)"/>
            <column name="strn" type="VARCHAR(50)"/>
            <column name="payment_terms" type="VARCHAR(100)"/>
            <column name="credit_limit" type="DECIMAL(15,2)" defaultValueNumeric="0"/>
            <column name="opening_balance" type="DECIMAL(15,2)" defaultValueNumeric="0"/>
            <column name="opening_balance_type" type="VARCHAR(10)"/>
            <column name="opening_date" type="DATE"/>
            <column name="status" type="VARCHAR(20)" defaultValue="ACTIVE"/>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP"/>
            <column name="updated_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP"/>
        </createTable>
    </changeSet>

    <changeSet id="003-2-create-supplier-ledger-table" author="system">
        <createTable tableName="supplier_ledger">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="supplier_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_supplier_ledger_supplier"
                             references="suppliers(id)"/>
            </column>
            <column name="transaction_date" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="VARCHAR(500)"/>
            <column name="reference_type" type="VARCHAR(50)"/>
            <column name="reference_id" type="BIGINT"/>
            <column name="debit" type="DECIMAL(15,2)" defaultValueNumeric="0"/>
            <column name="credit" type="DECIMAL(15,2)" defaultValueNumeric="0"/>
            <column name="balance" type="DECIMAL(15,2)" defaultValueNumeric="0"/>
            <column name="balance_type" type="VARCHAR(10)"/>
            <column name="created_by" type="BIGINT">
                <constraints foreignKeyName="fk_supplier_ledger_user" references="users(id)"/>
            </column>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP"/>
        </createTable>

        <createIndex tableName="supplier_ledger" indexName="idx_supplier_ledger_supplier">
            <column name="supplier_id"/>
        </createIndex>
        <createIndex tableName="supplier_ledger" indexName="idx_supplier_ledger_date">
            <column name="transaction_date"/>
        </createIndex>
    </changeSet>

    <changeSet id="003-3-create-purchases-table" author="system">
        <createTable tableName="purchases">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="purchase_number" type="VARCHAR(50)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="purchase_date" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="supplier_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_purchase_supplier"
                             references="suppliers(id)"/>
            </column>
            <column name="warehouse_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_purchase_warehouse"
                             references="warehouses(id)"/>
            </column>
            <column name="supplier_invoice_number" type="VARCHAR(100)"/>
            <column name="vehicle_number" type="VARCHAR(50)"/>
            <column name="driver_name" type="VARCHAR(100)"/>
            <column name="driver_phone" type="VARCHAR(20)"/>
            <column name="gross_weight" type="DECIMAL(15,3)"/>
            <column name="tare_weight" type="DECIMAL(15,3)"/>
            <column name="net_weight" type="DECIMAL(15,3)"/>
            <column name="total_amount" type="DECIMAL(15,2)"/>
            <column name="paid_amount" type="DECIMAL(15,2)" defaultValueNumeric="0"/>
            <column name="payment_status" type="VARCHAR(20)"/>
            <column name="payment_method" type="VARCHAR(20)"/>
            <column name="notes" type="TEXT"/>
            <column name="status" type="VARCHAR(20)" defaultValue="COMPLETED"/>
            <column name="created_by" type="BIGINT">
                <constraints foreignKeyName="fk_purchase_user" references="users(id)"/>
            </column>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP"/>
            <column name="updated_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP"/>
        </createTable>

        <createIndex tableName="purchases" indexName="idx_purchase_supplier">
            <column name="supplier_id"/>
        </createIndex>
        <createIndex tableName="purchases" indexName="idx_purchase_warehouse">
            <column name="warehouse_id"/>
        </createIndex>
        <createIndex tableName="purchases" indexName="idx_purchase_date">
            <column name="purchase_date"/>
        </createIndex>
    </changeSet>

    <changeSet id="003-4-create-purchase-items-table" author="system">
        <createTable tableName="purchase_items">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="purchase_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_purchase_item_purchase"
                             references="purchases(id)" deleteCascade="true"/>
            </column>
            <column name="product_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_purchase_item_product"
                             references="products(id)"/>
            </column>
            <column name="quantity" type="DECIMAL(15,3)">
                <constraints nullable="false"/>
            </column>
            <column name="rate" type="DECIMAL(15,2)">
                <constraints nullable="false"/>
            </column>
            <column name="amount" type="DECIMAL(15,2)">
                <constraints nullable="false"/>
            </column>
            <column name="gross_weight" type="DECIMAL(15,3)"/>
            <column name="tare_weight" type="DECIMAL(15,3)"/>
            <column name="net_weight" type="DECIMAL(15,3)"/>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP"/>
        </createTable>

        <createIndex tableName="purchase_items" indexName="idx_purchase_item_purchase">
            <column name="purchase_id"/>
        </createIndex>
        <createIndex tableName="purchase_items" indexName="idx_purchase_item_product">
            <column name="product_id"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>