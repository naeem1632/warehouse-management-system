<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <!-- Create stock_adjustments table -->
    <changeSet id="016-1" author="warehouse-system">
        <createTable tableName="stock_adjustments">
            <column name="id" type="BIGSERIAL">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="adjustment_number" type="VARCHAR(50)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="adjustment_date" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="warehouse_id" type="BIGINT">
                <constraints nullable="false"
                            foreignKeyName="fk_stock_adjustments_warehouse"
                            references="warehouses(id)"
                            deleteCascade="false"/>
            </column>
            <column name="product_id" type="BIGINT">
                <constraints nullable="false"
                            foreignKeyName="fk_stock_adjustments_product"
                            references="products(id)"
                            deleteCascade="false"/>
            </column>
            <column name="adjustment_type" type="VARCHAR(30)">
                <constraints nullable="false"/>
            </column>
            <column name="quantity_before" type="DECIMAL(15,3)">
                <constraints nullable="false"/>
            </column>
            <column name="adjustment_quantity" type="DECIMAL(15,3)">
                <constraints nullable="false"/>
            </column>
            <column name="quantity_after" type="DECIMAL(15,3)">
                <constraints nullable="false"/>
            </column>
            <column name="reason" type="TEXT">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="VARCHAR(20)" defaultValue="PENDING">
                <constraints nullable="false"/>
            </column>
            <column name="created_by" type="BIGINT">
                <constraints foreignKeyName="fk_stock_adjustments_created_by"
                            references="users(id)"
                            deleteCascade="false"/>
            </column>
            <column name="approved_by" type="BIGINT">
                <constraints foreignKeyName="fk_stock_adjustments_approved_by"
                            references="users(id)"
                            deleteCascade="false"/>
            </column>
            <column name="approved_at" type="TIMESTAMP"/>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP"/>
        </createTable>

        <createIndex tableName="stock_adjustments" indexName="idx_stock_adjustments_number">
            <column name="adjustment_number"/>
        </createIndex>
        <createIndex tableName="stock_adjustments" indexName="idx_stock_adjustments_warehouse">
            <column name="warehouse_id"/>
        </createIndex>
        <createIndex tableName="stock_adjustments" indexName="idx_stock_adjustments_product">
            <column name="product_id"/>
        </createIndex>
        <createIndex tableName="stock_adjustments" indexName="idx_stock_adjustments_date">
            <column name="adjustment_date"/>
        </createIndex>
        <createIndex tableName="stock_adjustments" indexName="idx_stock_adjustments_status">
            <column name="status"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
