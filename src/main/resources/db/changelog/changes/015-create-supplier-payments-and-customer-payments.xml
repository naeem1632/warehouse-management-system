<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <!-- Create supplier_payments table -->
    <changeSet id="015-1" author="warehouse-system">
        <createTable tableName="supplier_payments">
            <column name="id" type="BIGSERIAL">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="payment_number" type="VARCHAR(50)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="payment_date" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="supplier_id" type="BIGINT">
                <constraints nullable="false"
                            foreignKeyName="fk_supplier_payments_supplier"
                            references="suppliers(id)"
                            deleteCascade="false"/>
            </column>
            <column name="amount" type="DECIMAL(15,2)">
                <constraints nullable="false"/>
            </column>
            <column name="payment_method" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="bank_name" type="VARCHAR(100)"/>
            <column name="account_number" type="VARCHAR(50)"/>
            <column name="transaction_reference" type="VARCHAR(100)"/>
            <column name="cheque_number" type="VARCHAR(50)"/>
            <column name="cheque_date" type="DATE"/>
            <column name="notes" type="TEXT"/>
            <column name="created_by" type="BIGINT">
                <constraints foreignKeyName="fk_supplier_payments_user"
                            references="users(id)"
                            deleteCascade="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP"/>
        </createTable>

        <createIndex tableName="supplier_payments" indexName="idx_supplier_payments_number">
            <column name="payment_number"/>
        </createIndex>
        <createIndex tableName="supplier_payments" indexName="idx_supplier_payments_supplier">
            <column name="supplier_id"/>
        </createIndex>
        <createIndex tableName="supplier_payments" indexName="idx_supplier_payments_date">
            <column name="payment_date"/>
        </createIndex>
    </changeSet>

    <!-- Create customer_payments table -->
    <changeSet id="015-2" author="warehouse-system">
        <createTable tableName="customer_payments">
            <column name="id" type="BIGSERIAL">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="receipt_number" type="VARCHAR(50)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="payment_date" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="customer_id" type="BIGINT">
                <constraints nullable="false"
                            foreignKeyName="fk_customer_payments_customer"
                            references="customers(id)"
                            deleteCascade="false"/>
            </column>
            <column name="amount" type="DECIMAL(15,2)">
                <constraints nullable="false"/>
            </column>
            <column name="payment_method" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="bank_name" type="VARCHAR(100)"/>
            <column name="account_number" type="VARCHAR(50)"/>
            <column name="transaction_reference" type="VARCHAR(100)"/>
            <column name="cheque_number" type="VARCHAR(50)"/>
            <column name="cheque_date" type="DATE"/>
            <column name="notes" type="TEXT"/>
            <column name="received_by" type="BIGINT">
                <constraints foreignKeyName="fk_customer_payments_user"
                            references="users(id)"
                            deleteCascade="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP"/>
        </createTable>

        <createIndex tableName="customer_payments" indexName="idx_customer_payments_receipt">
            <column name="receipt_number"/>
        </createIndex>
        <createIndex tableName="customer_payments" indexName="idx_customer_payments_customer">
            <column name="customer_id"/>
        </createIndex>
        <createIndex tableName="customer_payments" indexName="idx_customer_payments_date">
            <column name="payment_date"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
