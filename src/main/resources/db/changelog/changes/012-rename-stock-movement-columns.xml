<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="012-rename-stock-movement-columns-1" author="system">
        <comment>Rename balance_before to quantity_before in stock_movements table for better clarity</comment>
        <renameColumn
                tableName="stock_movements"
                oldColumnName="balance_before"
                newColumnName="quantity_before"
                columnDataType="DECIMAL(15,3)"/>
    </changeSet>

    <changeSet id="012-rename-stock-movement-columns-2" author="system">
        <comment>Rename balance_after to quantity_after in stock_movements table for better clarity</comment>
        <renameColumn
                tableName="stock_movements"
                oldColumnName="balance_after"
                newColumnName="quantity_after"
                columnDataType="DECIMAL(15,3)"/>
    </changeSet>

</databaseChangeLog>
